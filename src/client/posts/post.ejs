<!DOCTYPE html>
<html lang="ko" class="<%= rootclass %>">
<head>
	<title><%= title %></title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/png" href="/assets/posts/favicon-dark.png" media="(prefers-color-scheme: dark)">
	<link rel="icon" type="image/png" href="/assets/posts/favicon.png" media="(prefers-color-scheme: light)">
</head>
<body>
	<%%- nav %>
	<main id="main"><%%- content %></main>
	<script>
		const scrollY = sessionStorage.getItem('scrollY');
		if (scrollY !== null) {
			window.scrollTo(0, parseInt(scrollY));
			sessionStorage.removeItem('scrollY');
		}
	</script>
</body>
</html>