<!DOCTYPE html>
<html lang="ko">
<head>
	<title>끾기록: 1차 기록</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/png" href="/assets/cycelog/favicon.png">
	<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-gov.min.css" media="screen and (min-width: 480px)">
</head>
<body>
	<div id="menubar"></div>
	<%%- header %>
	<%%- table %>
	<script>
		if (sessionStorage.getItem("cycelog.log1Path") !== window.location.pathname) sessionStorage.clear();
		sessionStorage.setItem("cycelog.log1Path", window.location.pathname);
		const scrollY = sessionStorage.getItem('scrollY');
		if (scrollY !== null) {
			window.scrollTo(0, parseInt(scrollY));
			sessionStorage.removeItem('scrollY');
		}
	</script>
</body>
</html>
