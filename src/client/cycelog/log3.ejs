<!DOCTYPE html>
<html lang="ko">
<head>
	<title>끾기록: 3차 기록</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/png" href="/assets/cycelog/favicon-dark.png" media="(prefers-color-scheme: dark)">
	<link rel="icon" type="image/png" href="/assets/cycelog/favicon.png" media="(prefers-color-scheme: light)">
	<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-gov.min.css">
	<link rel="stylesheet" as="style" crossorigin href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&display=swap">
	<script>window.LOG3_DATA = String.raw`<%%- entryData %>`;</script>
</head>
<body>
	<%%- nav %>
	<main id="main"><%%- content %></main>
	<script>
		document.querySelectorAll(".week").forEach((e, i) => {
			e.open = sessionStorage.getItem(`cycelog.week${i}`) === 'true';
			e.addEventListener('toggle', () => {
				sessionStorage.setItem(`cycelog.week${i}`, e.open);
			});
		});
		const scrollY = sessionStorage.getItem('scrollY');
		if (scrollY !== null) {
			window.scrollTo(0, parseInt(scrollY));
			sessionStorage.removeItem('scrollY');
		}
	</script>
</body>
</html>