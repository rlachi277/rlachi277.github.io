{
  "name": "cycweb",
  "version": "1.0.0",
  "description": "this is my first time using node.js",
  "license": "ISC",
  "author": "rlachi277",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:client": "tsc -p tsconfig.client.json --noEmit",
    "check:webpack": "tsc -p tsconfig.webpack.json --noEmit",
    "check": "npm run check:server && npm run check:client && npm run check:webpack",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --config webpack.config.ts",
    "build:vibing": "cpx \"src/vibing/**/*\" dist/vibing --ignore \"src/vibing/**/*.ts\" && tsc -p tsconfig.vibing.json",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:server && npm run build:client && npm run build:vibing",
    "test": "node dist/server/index.js",
    "dev": "nodemon -e ts,json,html,css --exec \"npm run build && npm run test\"",
    "dev:server": "nodemon -e ts,json,html,css --exec \"npm run build:server && npm run test\"",
    "dev:client": "nodemon -e ts,json,html,css --exec \"npm run build:client && npm run test\""
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "cpx2": "^9.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.3",
    "webpack-cli": "^7.1.0"
  }
}
