{
  "name": "cycweb",
  "version": "0.1.0",
  "description": "this is my first time using node.js",
  "license": "ISC",
  "author": "rlachi277",
  "type": "module",
  "scripts": {
    "check:mine": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:webpack": "tsc -p tsconfig.webpack.json --noEmit",
    "check:vibing": "tsc -p tsconfig.vibing.json --noEmit",
    "check": "pnpm check:mine && pnpm check:webpack && pnpm check:vibing",
    "clean": "rimraf dist",
    "build:mine": "tsc -p tsconfig.server.json && webpack --config webpack.config.ts",
    "build:vibing": "cpx \"src/vibing/**/*\" dist/vibing --ignore \"src/vibing/**/*.ts\" && tsc -p tsconfig.vibing.json",
    "build": "pnpm clean && pnpm build:mine && pnpm build:vibing",
    "start": "node dist/server/index.js",
    "start:app": "node dist/server/app.js",
    "dev": "nodemon -e ts,json,html,css --exec \"pnpm build && pnpm start\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "cpx2": "^9.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.62.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "webpack": "^5.110.1",
    "webpack-cli": "^7.2.2"
  }
}
